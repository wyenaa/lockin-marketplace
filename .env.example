# ============================================================
# LOCKIN — CONFIGURATION TEMPLATE
# Salin file ini menjadi .env dan sesuaikan nilai rahasia Anda.
# JANGAN pernah commit file .env ke GitHub!
# ============================================================

# --- SERVER ---
PORT=4000
HOST=127.0.0.1

# --- SUPABASE (Database & Auth) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- MIDTRANS SANDBOX ---
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxx
MIDTRANS_SIGNATURE_SECRET_KEY=Mid-server-xxxxxx

# --- ETHEREUM SEPOLIA TESTNET ---
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_ID
SEPOLIA_WRITER_PRIVATE_KEY=your_testnet_wallet_private_key

# Smart Contract Tunggal (LockInEscrow.sol)
SEPOLIA_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
